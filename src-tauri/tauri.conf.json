{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Grow with Time",
  "version": "1.0.0",
  "identifier": "com.minimal.todo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Grow with Time",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "visible": true,
        "focus": true
      },
      {
        "label": "quick-add",
        "title": "快速添加",
        "width": 420,
        "height": 120,
        "center": true,
        "visible": false,
        "alwaysOnTop": true,
        "resizable": false,
        "decorations": true,
        "skipTaskbar": true
      },
      {
        "label": "float",
        "title": "备忘录浮窗",
        "width": 320,
        "height": 420,
        "minWidth": 280,
        "minHeight": 320,
        "x": 40,
        "y": 80,
        "visible": false,
        "alwaysOnTop": true,
        "resizable": true,
        "decorations": false,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:app.db"]
    }
  }
}
