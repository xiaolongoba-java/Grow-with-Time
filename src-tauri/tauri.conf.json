{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Grow with Time",
  "version": "1.5.36",
  "identifier": "com.minimal.todo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "日进·拾光 · Grow with Time",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "transparent": true,
        "shadow": false,
        "backgroundColor": [
          0,
          0,
          0,
          0
        ],
        "titleBarStyle": "Overlay",
        "visible": false,
        "focus": true
      },
      {
        "label": "quick-add",
        "title": "快速添加",
        "width": 420,
        "height": 120,
        "center": true,
        "visible": false,
        "alwaysOnTop": true,
        "resizable": false,
        "decorations": true,
        "skipTaskbar": true
      },
      {
        "label": "inspiration",
        "title": "拾念",
        "width": 520,
        "height": 250,
        "center": true,
        "visible": false,
        "alwaysOnTop": true,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true
      },
      {
        "label": "float",
        "title": "备忘录浮窗",
        "width": 320,
        "height": 420,
        "minWidth": 280,
        "minHeight": 320,
        "x": 40,
        "y": 80,
        "visible": false,
        "alwaysOnTop": true,
        "resizable": true,
        "decorations": false,
        "skipTaskbar": true,
        "focus": false
      },
      {
        "label": "widget-calendar",
        "title": "月历",
        "width": 390,
        "height": 360,
        "minWidth": 340,
        "minHeight": 320,
        "x": 80,
        "y": 90,
        "visible": false,
        "alwaysOnTop": false,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": [0, 0, 0, 0],
        "skipTaskbar": true,
        "focus": true
      },
      {
        "label": "widget-today",
        "title": "今日计划",
        "width": 330,
        "height": 420,
        "minWidth": 300,
        "minHeight": 300,
        "x": 500,
        "y": 90,
        "visible": false,
        "alwaysOnTop": false,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": [0, 0, 0, 0],
        "skipTaskbar": true,
        "focus": true
      },
      {
        "label": "widget-memo",
        "title": "桌面备忘录",
        "width": 330,
        "height": 460,
        "minWidth": 300,
        "minHeight": 300,
        "x": 860,
        "y": 90,
        "visible": false,
        "alwaysOnTop": false,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": [0, 0, 0, 0],
        "skipTaskbar": true,
        "focus": true
      },
      {
        "label": "widget-dashboard",
        "title": "桌面仪表盘",
        "width": 1420,
        "height": 240,
        "minWidth": 1100,
        "minHeight": 210,
        "x": 80,
        "y": 40,
        "visible": false,
        "alwaysOnTop": false,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": [0, 0, 0, 0],
        "skipTaskbar": true,
        "focus": true
      },
      {
        "label": "widget-shortcuts",
        "title": "桌面快捷方式",
        "width": 720,
        "height": 118,
        "minWidth": 420,
        "minHeight": 100,
        "visible": false,
        "alwaysOnTop": false,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": [0, 0, 0, 0],
        "skipTaskbar": true,
        "focus": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      },
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost https://** http://localhost:** http://127.0.0.1:**",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'unsafe-inline' 'self'",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "本地优先的待办与时间管理",
    "longDescription": "日进·拾光（Grow with Time）— 让每日进步与灵感回忆都被看见的本地个人成长工具。",
    "copyright": "Copyright © 2026 日进·拾光",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "日进·拾光"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "background": "macos/dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:app.db"
      ]
    }
  }
}
